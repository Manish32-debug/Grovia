# Copy to .env and fill in. The API refuses to boot if any required value is
# missing or malformed (see src/config/env.ts) — a misconfigured deploy fails
# at startup, not at 3am in a request handler.

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# docker compose maps postgres to 5433 to avoid clashing with a local install
DATABASE_URL=postgresql://grovia:grovia_dev_password@localhost:5433/grovia?schema=public
# Poolers (Neon, pgbouncer) need a non-pooled URL for migrations. Unused
# locally; wired into prisma.config.ts in phase 15 when we move to Neon.
DIRECT_DATABASE_URL=postgresql://grovia:grovia_dev_password@localhost:5433/grovia?schema=public

# Comma-separated allowlist. No wildcard: refresh cookies require credentialed CORS.
CORS_ORIGINS=http://localhost:5173

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

# Generate a real one — the API refuses to start with fewer than 32 characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-48-byte-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Set in production only (e.g. .grovia.app); leave empty so localhost works.
# COOKIE_DOMAIN=

# --- phase 7 (Cashfree sandbox) ---
# CASHFREE_APP_ID=
# CASHFREE_SECRET_KEY=
# CASHFREE_WEBHOOK_SECRET=
# CASHFREE_ENV=SANDBOX

# --- phase 12 ---
# RESEND_API_KEY=
# CLOUDINARY_URL=
